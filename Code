int read_int(const string& prompt)
{
    int value;
    cout << prompt;
    while (!(cin >> value))
    {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Please enter a number: ";
    }
    return value;
}

void cast_vote_flow()
{
    Voter voter;
    string cnic, name, fname, province, mna_vote, mpa_vote, phone;
    int age, seat_mna, seat_mpa;

    cout << "\nEnter CNIC (no dashes): ";
    cin >> cnic;

    if (voter.vote_checking(cnic))
    {
        cout << "This CNIC has already voted. Access denied.\n";
        return;
    }

    cout << "Enter Name: ";
    cin >> name;
    cout << "Enter Father's Name: ";
    cin >> fname;
    age = read_int("Enter Age: ");

    if (!voter.check_age(age))
    {
        cout << "Voter must be 18 or older. Access denied.\n";
        return;
    }

    cout << "Enter Province: ";
    cin >> province;
    cout << "Enter Phone: ";
    cin >> phone;

    voter.setcnic(cnic);
    voter.setname(name);
    voter.setfname(fname);
    voter.setage(age);
    voter.setprovince(province);
    voter.setphone(phone);

    seat_mna = read_int("Enter MNA Seat number: ");
    seat_mpa = read_int("Enter MPA Seat number: ");
    voter.set_seats(seat_mna, seat_mpa);

    cout << "Enter MNA candidate symbol to vote for: ";
    cin >> mna_vote;
    if (!check_file(mna_vote))
    {
        cout << "Invalid candidate symbol. Vote rejected.\n";
        return;
    }

    cout << "Enter MPA candidate symbol to vote for: ";
    cin >> mpa_vote;
    if (!check_file(mpa_vote))
    {
        cout << "Invalid candidate symbol. Vote rejected.\n";
        return;
    }

    voter.set_votes(mna_vote, mpa_vote);

    // ever counted.
    if (!voter.seat_candidate_exists_mna())
    {
        cout << "No such MNA seat/candidate combination. Vote rejected — nothing recorded.\n";
        return;
    }
    if (!voter.seat_candidate_exists_mpa())
    {
        cout << "No such MPA seat/candidate combination. Vote rejected — nothing recorded.\n";
        return;
    }

    voter.update_in_file();      // voter + choice record
    voter.log_voted_record();    // "who has voted" 
    voter.increment_vote_mna();  // tallies  vote
    voter.increment_vote_mpa();  // tallies  vote

    cout << "Vote cast successfully. Thank you, " << name << ".\n";
}

int main()
{
    seed_files_if_missing();

    int choice;
    do
    {
        choice = read_int("\n===== Electronic Voting Machine =====\n1. Cast Vote\n2. Exit\nEnter choice: ");

        switch (choice)
        {
            case 1:
                cast_vote_flow();
                break;
            case 2:
                cout << "Exiting. Goodbye.\n";
                break;
            default:
                cout << "Invalid choice.\n";
        }
    } while (choice != 2);

    return 0;
}
